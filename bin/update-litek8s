#!/usr/bin/env bash
# Regenerate Formula/litek8s.rb for a litek8s release (default: the latest).
#
#   bin/update-litek8s [v0.1.0]
#
# Reads the release's SHA256SUMS, so the formula always matches the archives
# the release workflow uploaded. Needs gh (authenticated) and curl.
set -euo pipefail
REPO="${LITEK8S_REPO:-jairoFernandez/litek8s}"
cd "$(dirname "$0")/.."

tag="${1:-$(gh release view --repo "$REPO" --json tagName -q .tagName)}"
version="${tag#v}"
base="https://github.com/$REPO/releases/download/$tag"
sums="$(curl -fsSL "$base/SHA256SUMS")"

sha() {
  local file="litek8s-$tag-$1.tar.gz"
  local s
  s="$(awk -v f="$file" '$2 == f || $2 == "*"f { print $1 }' <<<"$sums")"
  [[ -n "$s" ]] || { echo "update-litek8s: $file not in $base/SHA256SUMS" >&2; exit 1; }
  echo "$s"
}

darwin_arm64="$(sha darwin-arm64)"
linux_x86_64="$(sha linux-x86_64)"
linux_aarch64="$(sha linux-aarch64)"

cat > Formula/litek8s.rb <<EOF
# Generated by bin/update-litek8s from the $tag release; do not edit by hand.
class Litek8s < Formula
  desc "Lightweight Kubernetes in one binary: dev clusters, Docker API, TUI, observability"
  homepage "https://litek8s.dev"
  version "$version"
  license "Apache-2.0"

  on_macos do
    # The dev VM (Virtualization.framework) is arm64 only.
    depends_on arch: :arm64

    url "$base/litek8s-$tag-darwin-arm64.tar.gz"
    sha256 "$darwin_arm64"
  end

  on_linux do
    on_intel do
      url "$base/litek8s-$tag-linux-x86_64.tar.gz"
      sha256 "$linux_x86_64"
    end
    on_arm do
      url "$base/litek8s-$tag-linux-aarch64.tar.gz"
      sha256 "$linux_aarch64"
    end
  end

  def install
    bin.install "bin/litek8s"
    # macOS: the dev VM's kernel and root image. litek8s finds them in
    # ../share/litek8s/vm next to its (resolved) binary.
    share.install "share/litek8s" if File.directory?("share/litek8s")
    doc.install Dir["README.md", "NOTICE", "THIRD-PARTY.md"]
    # \`litek8s completion <shell>\` exists from 0.1.1 on.
    if Utils.safe_popen_read(bin/"litek8s", "--help").include?("completion")
      generate_completions_from_executable(bin/"litek8s", "completion")
    end
  end

  def caveats
    <<~TEXT
      Start a local Kubernetes cluster (kubectl context litek8s-dev):
        litek8s dev up
      Terminal UI:
        litek8s ui
      Docker clients can use it too:
        export DOCKER_HOST=unix://\$HOME/.litek8s/docker.sock
    TEXT
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/litek8s --version")
    if OS.mac?
      assert_path_exists share/"litek8s/vm/Image"
      assert_path_exists share/"litek8s/vm/root.img"
    end
  end
end
EOF
echo "Formula/litek8s.rb -> $tag"
